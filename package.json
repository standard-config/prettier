{
	"name": "@standard-config/prettier-packages",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.21.0",
	"devDependencies": {
		"@standard-config/oxlint": "^2.12.0",
		"@standard-config/oxlint-stylistic": "^2.12.0",
		"@standard-config/prettier": "workspace:*",
		"@standard-config/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "5.1.0",
		"prettier": "catalog:",
		"prettier-plugin-shell": "workspace:*",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"build": "pnpm --filter @standard-config/prettier build",
		"build:editorconfig": "pnpm --filter @standard-config/prettier build:editorconfig",
		"fix": "pnpm build && pnpm format && pnpm lint && pnpm format",
		"fixtures:scramble": "pnpm --filter @standard-config/tests fixtures:scramble",
		"fixtures:unscramble": "pnpm --filter @standard-config/tests fixtures:unscramble",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "vp lint --fix",
		"lint:check": "vp lint --deny-warnings --type-check",
		"prepack": "pnpm build && pnpm run '/^(format:check|lint:check|test|typecheck)$/'",
		"prepare": "vp config --hooks-dir .hooks",
		"postprepare": "pnpm build",
		"test": "vp test",
		"test:editorconfig": "pnpm --filter @standard-config/prettier test:editorconfig",
		"test:fixtures": "pnpm build && pnpm --filter @standard-config/tests test:fixtures",
		"typecheck": "tsc --noEmit && pnpm --recursive typecheck"
	}
}
