{
	"name": "@standard-config/prettier",
	"version": "1.23.1",
	"description": "TypeScript-first Prettier config",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"homepage": "https://sconfig.org/prettier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/prettier.git",
		"directory": "packages/prettier"
	},
	"keywords": [
		"json-sorting",
		"oxc",
		"prettier",
		"prettier-config",
		"standard-config",
		"typescript"
	],
	"files": [
		".editorconfig",
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@prettier/plugin-oxc": "^0.2.4",
		"prettier-plugin-expand-json": "^1.2.1",
		"prettier-plugin-markdown-html": "^1.6.2",
		"prettier-plugin-pkg": "^0.22.1",
		"prettier-plugin-sh": "catalog:",
		"prettier-plugin-sort-json": "catalog:",
		"prettier-plugin-yaml": "^1.3.2"
	},
	"peerDependencies": {
		"prettier": "^3.10.0"
	},
	"devDependencies": {
		"@standard-config/tsconfig": "catalog:",
		"@standard-config/utilities": "workspace:*",
		"@types/node": "catalog:",
		"prettier": "catalog:",
		"publint": "^0.3.25",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"scripts": {
		"build": "pnpm run --sequential '/^build:/' && vp pack",
		"build:editorconfig": "node bin/generate-editorconfig.ts",
		"build:package": "node bin/prepare-package.ts",
		"prepack": "pnpm build",
		"test": "vp test",
		"test:editorconfig": "node bin/generate-editorconfig.ts --check && git diff --exit-code -- ../../.editorconfig",
		"typecheck": "tsc --noEmit"
	}
}
