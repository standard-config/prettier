// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`formats shell comments 1`] = `
"#!/bin/sh

# shellcheck source=./lib/common.sh
. "$(dirname "$0")/lib/common.sh"

# Keep two weeks of daily archives before the oldest ones are deleted, which
# matches the retention period of the offsite backups
RETENTION_DAYS=14

# Leave the tilde unexpanded, since the backup host resolves the archive path
# against its own home directory
#
# shellcheck disable=SC2088
ARCHIVE_DIR='~/Backups/logs'

# Compresses every log file in the current directory with one of these methods:
# - \`gzip\`, which is the default and runs on every supported system without
#   extra packages
# - \`zstd\`, which compresses faster but needs to be installed separately
#
# Arguments:
#   $1  Compression method, which falls back to \`gzip\` when the caller passes an empty value
compress_logs() {
  case "$1" in
    # Treat an empty method as the default, since cron jobs written before
    # \`zstd\` support pass no argument at all
    '' | gzip)
      # Overwrites existing archives, which only happens after an interrupted
      # run
      gzip -9 -- *.log
      ;;
  esac

  cat << EOF > README
# The nightly rotation job compresses the archives in this directory, so change the job instead of these files
EOF
}
"
`;
