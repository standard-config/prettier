root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown
[{*.livemd,*.markdown,*.md,*.mdown,*.mdwn,*.mdx,*.mkd,*.mkdn,*.mkdown,*.ronn,*.scd,*.workbook,contents.lr,README}]
indent_style = space

# Shell
[{.bash_aliases,.bash_functions,.bash_history,.bash_logout,.bash_profile,.bashrc,.cshrc,.envrc,.kshrc,.login,.profile,.tmux.conf,.xinitrc,.xsession,.zlogin,.zlogout,.zprofile,.zshenv,.zshrc,*.bash,*.bats,*.cgi,*.command,*.ebuild,*.eclass,*.fcgi,*.ksh,*.sbatch,*.sh,*.sh.in,*.slurm,*.tmux,*.tool,*.trigger,*.zsh,*.zsh-theme,9fs,APKBUILD,bash_aliases,bash_logout,bash_profile,bashrc,cshrc,gradlew,kshrc,login,man,mvnw,PKGBUILD,profile,tmux.conf,xinitrc,xsession,zlogin,zlogout,zprofile,zshenv,zshrc}]
indent_size = 2
indent_style = space

# Shell hooks
[{**/.hooks/*,**/.husky/*,**/.vite-hooks/*}]
indent_size = 2
indent_style = space

# YAML
[{.clang-format,.clang-tidy,.clangd,.eslintrc,.gemrc,.lintstagedrc,.prettierrc,.releaserc,.stylelintrc,*.mir,*.reek,*.rviz,*.sublime-syntax,*.syntax,*.yaml,*.yaml-tmlanguage,*.yaml.sed,*.yml,*.yml.mysql,CITATION.cff,glide.lock,pixi.lock}]
indent_size = 2
indent_style = space
